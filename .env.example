# Proyecto de Supabase (Settings → API). La publishable key es pública: va al navegador.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Cloudflare Turnstile (CAPTCHA invisible con IA). La Site Key es pública: va al navegador.
# Se crea en https://dash.cloudflare.com → Turnstile → Add site. La Secret Key va
# SOLO en Supabase (Auth → Providers → Captcha), nunca acá.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
